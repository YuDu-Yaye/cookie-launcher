<!--
    ============================================================
     Cookie Launcher theme tokens — defaults only.

     Every entry here is replaced at startup by ThemeService, which writes
     the generated Material 3 scheme into the application resource
     dictionary. The values below exist only so XAML parses before the
     service runs, and so the designer shows something sensible.

     Keys are a fixed contract: App.xaml styles bind them through
     DynamicResource, and ThemeService publishes exactly this set.
    ============================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colour roles (placeholder values, overwritten at startup) -->
    <Color x:Key="PrimaryColor">#FFC97F3E</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="PrimaryContainerColor">#FFFFDCC2</Color>
    <Color x:Key="OnPrimaryContainerColor">#FF2E1500</Color>

    <Color x:Key="SecondaryColor">#FF755845</Color>
    <Color x:Key="OnSecondaryColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryContainerColor">#FFFFDCC2</Color>
    <Color x:Key="OnSecondaryContainerColor">#FF2B1608</Color>

    <Color x:Key="TertiaryColor">#FF5C6B2E</Color>
    <Color x:Key="OnTertiaryColor">#FFFFFFFF</Color>
    <Color x:Key="TertiaryContainerColor">#FFE0EF9A</Color>
    <Color x:Key="OnTertiaryContainerColor">#FF191E00</Color>

    <Color x:Key="ErrorColor">#FFBA1A1A</Color>
    <Color x:Key="OnErrorColor">#FFFFFFFF</Color>
    <Color x:Key="ErrorContainerColor">#FFFFDAD6</Color>
    <Color x:Key="OnErrorContainerColor">#FF410002</Color>

    <Color x:Key="SurfaceColor">#FF161310</Color>
    <Color x:Key="OnSurfaceColor">#FFE9E1DB</Color>
    <Color x:Key="SurfaceVariantColor">#FF4F453D</Color>
    <Color x:Key="OnSurfaceVariantColor">#FFD3C4B9</Color>
    <Color x:Key="SurfaceContainerLowestColor">#FF110D0A</Color>
    <Color x:Key="SurfaceContainerLowColor">#FF1E1B18</Color>
    <Color x:Key="SurfaceContainerColor">#FF231F1C</Color>
    <Color x:Key="SurfaceContainerHighColor">#FF2D2925</Color>
    <Color x:Key="SurfaceContainerHighestColor">#FF38332F</Color>

    <Color x:Key="OutlineColor">#FF9C8C81</Color>
    <Color x:Key="OutlineVariantColor">#FF4F453D</Color>
    <Color x:Key="InverseSurfaceColor">#FFE9E1DB</Color>
    <Color x:Key="OnInverseSurfaceColor">#FF332F2B</Color>
    <Color x:Key="InversePrimaryColor">#FFC97F3E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainerColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="InverseSurfaceBrush" Color="{StaticResource InverseSurfaceColor}" />
    <SolidColorBrush x:Key="OnInverseSurfaceBrush" Color="{StaticResource OnInverseSurfaceColor}" />

    <!-- Glass surfaces (translucent, overwritten by ThemeService) -->
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#9E1E1B18" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#B4231F1C" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#C82D2925" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#D838332F" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1FD3C4B9" />
    <SolidColorBrush x:Key="StateHoverBrush" Color="#14E9E1DB" />
    <SolidColorBrush x:Key="StatePressedBrush" Color="#1FE9E1DB" />
    <SolidColorBrush x:Key="RippleBrush" Color="#29E9E1DB" />
    <SolidColorBrush x:Key="InputFillBrush" Color="#14E9E1DB" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#1FE9E1DB" />
    <SolidColorBrush x:Key="DisabledContainerBrush" Color="#1FE9E1DB" />
    <SolidColorBrush x:Key="DisabledLabelBrush" Color="#61E9E1DB" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66D3C4B9" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#99D3C4B9" />

    <LinearGradientBrush x:Key="GlassTintBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#8A0E0C11" Offset="0" />
        <GradientStop Color="#8A07060A" Offset="0.55" />
        <GradientStop Color="#8A0E0C11" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33D3C4B9" Offset="0" />
        <GradientStop Color="#14D3C4B9" Offset="0.5" />
        <GradientStop Color="#33D3C4B9" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
