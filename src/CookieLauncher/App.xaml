<!--
    ============================================================
     Cookie Launcher — Material Design 3 component library.

     Every value maps to a published M3 token: the type scale
     (Display/Headline/Title/Body/Label), the shape scale
     (xs 4 / s 8 / m 12 / l 16 / xl 28 / full), the elevation levels,
     and the state-layer opacities (hover 8%, focus 10%, press 10%).

     Colour roles come from ThemeService at runtime through
     DynamicResource, so switching schemes repaints without
     reloading a single style.
    ============================================================
-->
<Application x:Class="CookieLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CookieLauncher.UI"
             StartupUri="Shell/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Theme tokens are merged first so the styles below can resolve them. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

            <!--
            ============================================================
             TYPOGRAPHY
             Segoe UI Variable carries display/headline, Segoe UI the
             body, mirroring Material's display/text split.
            ============================================================
            -->
            <FontFamily x:Key="MdTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="MdDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="MdIconFont">Segoe MDL2 Assets</FontFamily>

            <!-- Display: 57 / 45 / 36, line height ~1.12 -->
            <Style x:Key="MdDisplayLarge" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdDisplayFont}" />
                <Setter Property="FontSize" Value="45" />
                <Setter Property="LineHeight" Value="52" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <Style x:Key="MdDisplaySmall" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdDisplayFont}" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="LineHeight" Value="40" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <!-- Headline: 32 / 28 / 24 -->
            <Style x:Key="MdHeadlineMedium" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdDisplayFont}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="LineHeight" Value="34" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <Style x:Key="MdHeadlineSmall" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdDisplayFont}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="LineHeight" Value="30" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <!-- Title: 22 / 16 / 14 -->
            <Style x:Key="MdTitleLarge" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="LineHeight" Value="28" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <Style x:Key="MdTitleMedium" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <Style x:Key="MdTitleSmall" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            </Style>

            <!-- Body: 16 / 14 / 12 -->
            <Style x:Key="MdBodyLarge" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MdBodyMedium" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MdBodySmall" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            </Style>

            <!-- Label: 14 / 12 / 11 -->
            <Style x:Key="MdLabelLarge" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            </Style>

            <Style x:Key="MdLabelMedium" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            </Style>

            <Style x:Key="MdLabelSmall" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            </Style>

            <!--
            ============================================================
             STATE LAYER ANIMATIONS
             M3 state layers are opacity transitions on an overlay,
             not colour swaps: hover 8%, press 10%.
            ============================================================
            -->
            <Storyboard x:Key="MdStateHoverIn">
                <DoubleAnimation Storyboard.TargetName="StateLayer"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0.08" Duration="0:0:0.12" />
            </Storyboard>

            <Storyboard x:Key="MdStateHoverOut">
                <DoubleAnimation Storyboard.TargetName="StateLayer"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.18" />
            </Storyboard>

            <Storyboard x:Key="MdStatePressIn">
                <DoubleAnimation Storyboard.TargetName="StateLayer"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0.10" Duration="0:0:0.08" />
            </Storyboard>

            <Storyboard x:Key="MdRippleExpand">
                <DoubleAnimation Storyboard.TargetName="RippleScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 To="1" Duration="0:0:0.42">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RippleScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 To="1" Duration="0:0:0.42">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Ripple"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.14" To="0" BeginTime="0:0:0.16"
                                 Duration="0:0:0.30" />
            </Storyboard>

            <!--
            ============================================================
             BUTTONS
             M3: 40dp height, 20dp radius (full), 24dp horizontal
             padding, label-large type. Five emphasis levels.
            ============================================================
            -->
            <Style x:Key="MdFilledButton" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Surface"
                                        CornerRadius="20"
                                        Background="{DynamicResource PrimaryBrush}" />
                                <Border x:Name="StateLayer"
                                        CornerRadius="20"
                                        Background="{DynamicResource OnPrimaryBrush}"
                                        Opacity="0" />
                                <Border CornerRadius="20" ClipToBounds="True">
                                    <Ellipse x:Name="Ripple"
                                             Fill="{DynamicResource OnPrimaryBrush}"
                                             Opacity="0"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="RippleScale"
                                                            ScaleX="0.2" ScaleY="0.2" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                        <BeginStoryboard Storyboard="{StaticResource MdRippleExpand}" />
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background"
                                            Value="{DynamicResource DisabledContainerBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DisabledLabelBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MdTonalButton" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Surface"
                                        CornerRadius="20"
                                        Background="{DynamicResource SecondaryContainerBrush}" />
                                <Border x:Name="StateLayer"
                                        CornerRadius="20"
                                        Background="{DynamicResource OnSecondaryContainerBrush}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background"
                                            Value="{DynamicResource DisabledContainerBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DisabledLabelBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MdOutlinedButton" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Surface"
                                        CornerRadius="20"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1" />
                                <Border x:Name="StateLayer"
                                        CornerRadius="20"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="BorderBrush"
                                            Value="{DynamicResource DisabledContainerBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DisabledLabelBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MdTextButton" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="StateLayer"
                                        CornerRadius="20"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DisabledLabelBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Destructive action: error roles instead of primary. -->
            <Style x:Key="MdDangerButton" TargetType="Button" BasedOn="{StaticResource MdTonalButton}">
                <Setter Property="Foreground" Value="{DynamicResource OnErrorContainerBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Surface"
                                        CornerRadius="20"
                                        Background="{DynamicResource ErrorContainerBrush}" />
                                <Border x:Name="StateLayer"
                                        CornerRadius="20"
                                        Background="{DynamicResource OnErrorContainerBrush}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 40dp circular icon button. -->
            <Style x:Key="MdIconButton" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="StateLayer"
                                        CornerRadius="20"
                                        Background="{DynamicResource OnSurfaceBrush}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            ============================================================
             NAVIGATION RAIL ITEM
             M3: 56dp tall, pill indicator using the secondary
             container role, icon above label.
            ============================================================
            -->
            <Style x:Key="MdNavRailItem" TargetType="RadioButton">
                <Setter Property="Height" Value="64" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextBlock.TextAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="64"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,6,0,0"
                                        Background="Transparent"
                                        CornerRadius="16" />
                                <Border x:Name="StateLayer"
                                        Width="64"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,6,0,0"
                                        CornerRadius="16"
                                        Background="{DynamicResource OnSurfaceBrush}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Top"
                                                  Margin="0,10,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Indicator" Property="Background"
                                            Value="{DynamicResource SecondaryContainerBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnSecondaryContainerBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Indicator" Property="BorderBrush"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Indicator" Property="BorderThickness"
                                            Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            ============================================================
             CARDS — M3: 12dp radius. Filled uses surface container,
             outlined adds a 1dp outline-variant border.
            ============================================================
            -->
            <Style x:Key="MdCardFilled" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="MdCardOutlined" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- The hero card is larger, so it earns the extra-large radius. -->
            <Style x:Key="MdHeroCard" TargetType="Border" BasedOn="{StaticResource MdCardFilled}">
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="Padding" Value="28" />
            </Style>

            <!--
            ============================================================
             CHIPS — M3: 32dp height, 8dp radius.
            ============================================================
            -->
            <Style x:Key="MdAssistChip" TargetType="Border">
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MdFilterChip" TargetType="Border">
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Status pill: a small tinted label, not a full chip. -->
            <Style x:Key="MdStatusPill" TargetType="Border">
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
            ============================================================
             TEXT FIELD
             M3 filled: surface-variant container, square top corners,
             rounded bottom, 1dp underline that becomes 2dp on focus.
            ============================================================
            -->
            <Style x:Key="MdTextField" TargetType="TextBox">
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Container"
                                        Background="{DynamicResource SurfaceContainerHighestBrush}"
                                        CornerRadius="4,4,0,0" />
                                <Border x:Name="Underline"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource OnSurfaceVariantBrush}" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                                <TextBlock x:Name="Placeholder"
                                           Margin="17,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           Opacity="0.75"
                                           Text="{TemplateBinding Tag}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Underline" Property="Height" Value="2" />
                                    <Setter TargetName="Underline" Property="Background"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Placeholder" Property="Visibility"
                                            Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Container" Property="Background"
                                            Value="{DynamicResource InputHoverBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value="" />
                                        <Condition Property="IsKeyboardFocused" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Placeholder" Property="Visibility"
                                            Value="Visible" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value="" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Placeholder" Property="Visibility"
                                            Value="Visible" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            ============================================================
             DIVIDER — 1dp, outline-variant.
            ============================================================
            -->
            <Style x:Key="MdDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource OutlineVariantBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!--
            ============================================================
             SCROLLBAR — 8dp rounded thumb, no arrow buttons.
            ============================================================
            -->
            <Style x:Key="MdScrollThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bar"
                                    Width="6"
                                    Margin="3,0"
                                    CornerRadius="3"
                                    Background="{DynamicResource ScrollThumbBrush}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Background"
                                            Value="{DynamicResource ScrollThumbHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bar" Property="Background"
                                            Value="{DynamicResource ScrollThumbHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MdScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track"
                                            Property="IsDirectionReversed" Value="False" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            ============================================================
             WINDOW CONTROLS
             46x32 transparent buttons with a 6dp rounded hover state.
            ============================================================
            -->
            <Style x:Key="MdWindowButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource MdIconFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource StateHoverBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource StatePressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MdCloseWindowButton" TargetType="Button"
                   BasedOn="{StaticResource MdWindowButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource ErrorContainerBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnErrorContainerBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource ErrorBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnErrorBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            ============================================================
             LISTS — M3 list item: 56dp minimum, state layer on the row.
            ============================================================
            -->
            <Style x:Key="MdListItem" TargetType="Border">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="MdListItemHover" TargetType="Border"
                   BasedOn="{StaticResource MdListItem}">
                <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            </Style>

            <!--
            ============================================================
             SWITCH AND SLIDER
             M3 switch: 52x32 track, 24dp thumb. Slider: 4dp track.
            ============================================================
            -->
            <Style x:Key="MdSwitch" TargetType="CheckBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="52" Height="32" VerticalAlignment="Center">
                                    <Border x:Name="Track"
                                            CornerRadius="16"
                                            Background="{DynamicResource SurfaceContainerHighestBrush}"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="2" />
                                    <Border x:Name="Knob"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource OutlineBrush}" />
                                </Grid>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Knob" Property="Margin"
                                            Value="24,0,0,0" />
                                    <Setter TargetName="Knob" Property="Background"
                                            Value="{DynamicResource OnPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MdSlider" TargetType="Slider">
                <Setter Property="Height" Value="32" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceContainerHighestBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="20" Height="20">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{DynamicResource PrimaryBrush}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            ============================================================
             LAUNCHER GLYPHS — Material Symbols paths, 24x24 viewbox.
            ============================================================
            -->
            <PathGeometry x:Key="PlayGlyph" Figures="M8 5v14l11-7z" />
            <PathGeometry x:Key="VersionsGlyph" Figures="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" />
            <PathGeometry x:Key="ModsGlyph"
                          Figures="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z" />
            <PathGeometry x:Key="AccountGlyph"
                          Figures="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
            <PathGeometry x:Key="LogsGlyph"
                          Figures="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 12H7v-2h10v2zm0-4H7V9h10v2zm0-4H7V5h10v2z" />
            <PathGeometry x:Key="SettingsGlyph"
                          Figures="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />


            <!--
            ============================================================
             MENU (ComboBox)
             M3 exposed dropdown: 48dp tall, surface-container fill,
             1dp outline, menu surface high.
            ============================================================
            -->
            <Style x:Key="MdComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Row"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource StateHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource SecondaryContainerBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnSecondaryContainerBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MdComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="48" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource MdComboBoxItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Field"
                                        CornerRadius="4"
                                        Background="{DynamicResource SurfaceContainerHighestBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1" />
                                <ContentPresenter Margin="14,0,36,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Path x:Name="Chevron"
                                      Width="10" Height="6"
                                      Margin="0,0,14,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Data="M0,0 L5,5 L10,0"
                                      Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                      StrokeThickness="1.6" />
                                <ToggleButton Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}" />
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       PopupAnimation="Fade">
                                    <Border Margin="0,4,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="280"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceContainerHighBrush}"
                                            BorderBrush="{DynamicResource OutlineVariantBrush}"
                                            BorderThickness="1"
                                            Padding="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush"
                                            Value="{DynamicResource OnSurfaceVariantBrush}" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Field" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DisabledLabelBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
