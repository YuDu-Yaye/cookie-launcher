<Application x:Class="CookieLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CookieLauncher.UI"
             StartupUri="Shell/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                Theme tokens live in a separate dictionary so ThemeManager can
                rewrite them in place at runtime and have every DynamicResource
                reference repaint. Theme.xaml holds the default (dark) scheme;
                it must be merged first so the styles below can resolve tokens.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converts a bool selection flag into element visibility. -->
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

            <!--
            ====
             Material Design 3 — type and component styles
             Roboto is not installed on this machine, so Segoe UI Variable
             stands in. Segoe UI Variable Display carries the large
             display/headline styles and Text carries body/label styles,
             mirroring Material's Display/Text typeface split.

             Colour references use DynamicResource so the light/dark switch
             repaints them without reloading any style.
            ====
            -->

            <!--
                Typeface. One family for the whole UI, so headings and body text can
                never drift into different typefaces. The family ships with the app
                (see Fonts/), which is what keeps Latin and Chinese on the same face
                instead of falling back per glyph.
            -->
            <FontFamily x:Key="MdTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="MdDisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>

        <!--
            ============================================================
             M3 navigation rail — tokens
             Rail width .......... 80dp
             Top padding ......... 12dp (before the first destination)
             Destination layout .. icon over label, 4dp gap
             Active indicator .... 56x32dp, fully rounded, secondary-container
             Icon ................ 24dp
             Label ............... label-medium (12sp / 16dp line)
             Spacing ............. 12dp between destinations
            ============================================================
        -->
        <!--
            ============================================================
             Shared interaction states.

             Every interactive control paints a StateLayer border named
             exactly "StateLayer", tinted with the relevant on-colour and
             left at Opacity 0. These storyboards ramp that opacity, so
             hover and press feel identical across buttons, chips,
             segments, icon buttons and rail destinations.

             M3 state layer opacities: hover 8%, press 14%.
             ============================================================
        -->
        <Storyboard x:Key="MdStateHoverIn">
            <DoubleAnimation Storyboard.TargetName="StateLayer"
                             Storyboard.TargetProperty="Opacity"
                             To="0.08" Duration="0:0:0.12" />
        </Storyboard>

        <Storyboard x:Key="MdStateHoverOut">
            <DoubleAnimation Storyboard.TargetName="StateLayer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.18" />
        </Storyboard>

        <Storyboard x:Key="MdStatePressIn">
            <DoubleAnimation Storyboard.TargetName="StateLayer"
                             Storyboard.TargetProperty="Opacity"
                             To="0.14" Duration="0:0:0.08" />
        </Storyboard>

        <!--
            Ripple expansion, shared by every button that wants one.

            The template supplies an Ellipse named "Ripple" with a ScaleTransform named
            "RippleScale"; this grows it from a point to past the button's corners while fading out.
            Material's ripple is a touch response, so it runs on press rather than on click and is
            deliberately faster than a decorative animation would be.
        -->
        <Storyboard x:Key="MdRippleExpand">
            <DoubleAnimation Storyboard.TargetName="RippleScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.2" To="1.6" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RippleScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.2" To="1.6" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Ripple"
                             Storyboard.TargetProperty="Opacity"
                             From="0.85" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--
            ============================================================
             M3 navigation rail item: a 56dp pill indicator with the icon
             above the label. The indicator uses the secondary container
             role, which is the M3 colour for a selected destination.
            ============================================================
        -->
        <Style x:Key="MdNavRailItem" TargetType="RadioButton">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Indicator"
                                Background="Transparent"
                                CornerRadius="28"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Indicator" Property="Background"
                                        Value="{DynamicResource StateHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background"
                                        Value="{DynamicResource SecondaryContainerBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource OnSecondaryContainerBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Indicator" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Indicator" Property="BorderThickness"
                                        Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            App mark glyph — Material Symbols "storm", path data taken verbatim
            from the 24dp SVG (960-unit grid, y from -960 to 0).
            This is a FILLED icon: its subpaths describe solid regions plus holes,
            so it must be filled. Stroking it would trace both the outer and the
            inner contours, which produces muddy double lines.
        -->
        <PathGeometry x:Key="StormGlyph"
                      FillRule="Nonzero"
                      Figures="M726-80q25-62 35-127t5-131q-39 83-116.5 130.5T480-160q-84 0-152-39.5T212-305q-48-66-74-151.5T112-634q0-63 8.5-124.5T150-880h84q-24 62-34.5 127T194-622q39-83 116.5-130.5T480-800q84 0 152 39.5T748-655q48 66 74 151.5T848-326q0 63-8.5 124.5T810-80h-84ZM480-240q100 0 170-70t70-170q0-100-70-170t-170-70q-100 0-170 70t-70 170q0 100 70 170t170 70Zm113-127q47-47 47-113t-47-113q-47-47-113-47t-113 47q-47 47-47 113t47 113q47 47 113 47t113-47Zm-169.5-56.5Q400-447 400-480t23.5-56.5Q447-560 480-560t56.5 23.5Q560-513 560-480t-23.5 56.5Q513-400 480-400t-56.5-23.5Z" />

        <!--
            App mark — Material Symbols "eco", path data taken verbatim from the
            supplied 24dp SVG (960-unit grid, y from -960 to 0). Like the storm
            glyph this is a FILLED icon: its subpaths describe a solid body with
            the leaf vein cut out, so it must be filled, not stroked.
        -->
        <PathGeometry x:Key="EcoGlyph"
                      FillRule="Nonzero"
                      Figures="M216-176q-45-45-70.5-104T120-402q0-63 24-124.5T222-642q35-35 86.5-60t122-39.5Q501-756 591.5-759t202.5 7q8 106 5 195t-16.5 160.5q-13.5 71.5-38 125T684-182q-53 53-112.5 77.5T450-80q-65 0-127-25.5T216-176Zm112-16q29 17 59.5 24.5T450-160q46 0 91-18.5t86-59.5q18-18 36.5-50.5t32-85Q709-426 716-500.5t2-177.5q-49-2-110.5-1.5T485-670q-61 9-116 29t-90 55q-45 45-62 89t-17 85q0 59 22.5 103.5T262-246q42-80 111-153.5T534-520q-72 63-125.5 142.5T328-192Z" />

        <!--
            ============================================================
             Material Symbols — navigation destinations.
             Each destination ships an outlined and a filled variant, as M3
             specifies: outlined when unselected, filled when selected.
             Outlined variants use EvenOdd so an inner contour punches the
             body out and leaves a consistent ring, rather than a second
             stroke pass. Geometry is on the standard 24dp grid.
            ============================================================
        -->

        <!-- home -->
        <PathGeometry x:Key="HomeOutlined" FillRule="EvenOdd"
                      Figures="M12,3 L2,12 H5 V20 H19 V12 H22 Z M12,6.2 L7,10.5 V17.6 H17 V10.5 Z" />
        <PathGeometry x:Key="HomeFilled" FillRule="Nonzero"
                      Figures="M12,3 L2,12 H5 V20 H10 V14 H14 V20 H19 V12 H22 Z" />

        <!-- logs / document -->
        <PathGeometry x:Key="LogsOutlined" FillRule="EvenOdd"
                      Figures="M6,2.5 H18 V21.5 H6 Z M8.2,4.7 V19.3 H15.8 V4.7 Z M9.6,8 H14.4 V9.4 H9.6 Z M9.6,11 H14.4 V12.4 H9.6 Z M9.6,14 H12.8 V15.4 H9.6 Z" />
        <PathGeometry x:Key="LogsFilled" FillRule="EvenOdd"
                      Figures="M6,2.5 H18 V21.5 H6 Z M9.6,8 H14.4 V9.4 H9.6 Z M9.6,11 H14.4 V12.4 H9.6 Z M9.6,14 H12.8 V15.4 H9.6 Z" />

        <!--
            settings — a gear built from one accurate silhouette plus a centre
            hole. The outlined variant uses a wider hole, which reads as a thin
            gear ring; the filled variant uses the standard narrow hole.
        -->
        <PathGeometry x:Key="SettingsOutlined" FillRule="EvenOdd"
                      Figures="M19.43,12.98 c0.04,-0.32 0.07,-0.64 0.07,-0.98 s-0.02,-0.66 -0.07,-0.98 l2.11,-1.65 c0.19,-0.15 0.24,-0.42 0.12,-0.64 l-2,-3.46 c-0.12,-0.22 -0.39,-0.3 -0.61,-0.22 l-2.49,1 c-0.52,-0.4 -1.08,-0.73 -1.69,-0.98 l-0.38,-2.65 C14.46,2.18 14.25,2 14,2 h-4 c-0.25,0 -0.46,0.18 -0.49,0.42 l-0.38,2.65 c-0.61,0.25 -1.17,0.59 -1.69,0.98 l-2.49,-1 c-0.23,-0.08 -0.49,0 -0.61,0.22 l-2,3.46 c-0.13,0.22 -0.07,0.49 0.12,0.64 l2.11,1.65 C4.52,11.34 4.5,11.66 4.5,12 s0.02,0.66 0.07,0.98 l-2.11,1.65 c-0.19,0.15 -0.24,0.42 -0.12,0.64 l2,3.46 c0.12,0.22 0.39,0.3 0.61,0.22 l2.49,-1 c0.52,0.4 1.08,0.73 1.69,0.98 l0.38,2.65 C9.54,21.82 9.75,22 10,22 h4 c0.25,0 0.46,-0.18 0.49,-0.42 l0.38,-2.65 c0.61,-0.25 1.17,-0.59 1.69,-0.98 l2.49,1 c0.23,0.08 0.49,0 0.61,-0.22 l2,-3.46 c0.12,-0.22 0.07,-0.49 -0.12,-0.64 Z M12,6.4 A5.6,5.6 0 1 0 12,17.6 A5.6,5.6 0 1 0 12,6.4 Z" />
        <PathGeometry x:Key="SettingsFilled" FillRule="EvenOdd"
                      Figures="M19.43,12.98 c0.04,-0.32 0.07,-0.64 0.07,-0.98 s-0.02,-0.66 -0.07,-0.98 l2.11,-1.65 c0.19,-0.15 0.24,-0.42 0.12,-0.64 l-2,-3.46 c-0.12,-0.22 -0.39,-0.3 -0.61,-0.22 l-2.49,1 c-0.52,-0.4 -1.08,-0.73 -1.69,-0.98 l-0.38,-2.65 C14.46,2.18 14.25,2 14,2 h-4 c-0.25,0 -0.46,0.18 -0.49,0.42 l-0.38,2.65 c-0.61,0.25 -1.17,0.59 -1.69,0.98 l-2.49,-1 c-0.23,-0.08 -0.49,0 -0.61,0.22 l-2,3.46 c-0.13,0.22 -0.07,0.49 0.12,0.64 l2.11,1.65 C4.52,11.34 4.5,11.66 4.5,12 s0.02,0.66 0.07,0.98 l-2.11,1.65 c-0.19,0.15 -0.24,0.42 -0.12,0.64 l2,3.46 c0.12,0.22 0.39,0.3 0.61,0.22 l2.49,-1 c0.52,0.4 1.08,0.73 1.69,0.98 l0.38,2.65 C9.54,21.82 9.75,22 10,22 h4 c0.25,0 0.46,-0.18 0.49,-0.42 l0.38,-2.65 c0.61,-0.25 1.17,-0.59 1.69,-0.98 l2.49,1 c0.23,0.08 0.49,0 0.61,-0.22 l2,-3.46 c0.12,-0.22 0.07,-0.49 -0.12,-0.64 Z M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z" />

        <!-- person -->
        <PathGeometry x:Key="PersonOutlined" FillRule="EvenOdd"
                      Figures="M12,3.4 A4.3,4.3 0 1 0 12,12 A4.3,4.3 0 1 0 12,3.4 Z M12,5.6 A2.1,2.1 0 1 1 12,9.8 A2.1,2.1 0 1 1 12,5.6 Z M4,21 V19.2 C4,16.3 8,14.8 12,14.8 C16,14.8 20,16.3 20,19.2 V21 Z M6.3,18.9 C6.8,17.4 9.2,16.7 12,16.7 C14.8,16.7 17.2,17.4 17.7,18.9 Z" />
        <PathGeometry x:Key="PersonFilled" FillRule="Nonzero"
                      Figures="M12,3.4 A4.3,4.3 0 1 1 12,12 A4.3,4.3 0 1 1 12,3.4 Z M4,21 V19.2 C4,16.3 8,14.8 12,14.8 C16,14.8 20,16.3 20,19.2 V21 Z" />

        <!--
            ==== Type scale ====

            Deliberately narrow: four sizes, two weights, one family. A wider scale
            produced the mixed look where headings, labels and body text all seemed to
            come from different fonts.

            20 / 16 / 14 / 12 sp, and weight is semantic only:
              Medium (500)  headings, labels, selected state
              Regular (400) body text
            Nothing uses Bold, so no text can look heavier than a heading.
        -->

        <Style x:Key="MdDisplaySmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdDisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>

        <Style x:Key="MdHeadlineSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdDisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>

        <Style x:Key="MdTitleMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>

        <Style x:Key="MdTitleSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>

        <Style x:Key="MdBodyMedium" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        </Style>

        <Style x:Key="MdBodySmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        </Style>

        <Style x:Key="MdLabelLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        </Style>

        <Style x:Key="MdLabelSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        </Style>

        <!--
        ====
         M3 icon button with a state layer and a Material ripple.
         Shape: circle — 32dp button, 16dp corner radius.
        ====
        -->
        <Style x:Key="MdIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True">
                            <Border x:Name="StateLayer" CornerRadius="16" Opacity="0" Background="{DynamicResource OnSurfaceBrush}" />
                            <Border CornerRadius="16" ClipToBounds="True">
                                <Ellipse x:Name="Ripple"
                                         Fill="{StaticResource RippleBrush}"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RippleScale" ScaleX="0.2" ScaleY="0.2" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    <BeginStoryboard Storyboard="{StaticResource MdRippleExpand}" />
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: M3 error roles for its interaction states -->
        <Style x:Key="MdCloseButton" TargetType="Button" BasedOn="{StaticResource MdIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True">
                            <Border x:Name="StateLayer" CornerRadius="16" Opacity="0" Background="{DynamicResource CloseHoverBrush}" />
                            <Border CornerRadius="16" ClipToBounds="True">
                                <Ellipse x:Name="Ripple"
                                         Fill="{DynamicResource CloseRippleBrush}"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RippleScale" ScaleX="0.2" ScaleY="0.2" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource OnErrorContainerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnErrorContainerBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                    <BeginStoryboard Storyboard="{StaticResource MdRippleExpand}" />
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M3 assist chip: 32dp tall, 8dp corner, 1dp outline -->
        <Style x:Key="MdChip" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- M3 card: 12dp corner, 1dp outline variant, 20dp padding -->
        <Style x:Key="MdCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!--
            ============================================================
             M3 list item — 56dp tall, 16dp leading/trailing padding.
            ============================================================
        -->
        <Style x:Key="MdListItem" TargetType="Grid">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <!-- M3 divider: 1dp, outline-variant -->
        <Style x:Key="MdDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource OutlineVariantBrush}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <!--
            ============================================================
             M3 filled button — 40dp tall, 20dp corner (full), primary fill
            ============================================================
        -->
        <Style x:Key="MdFilledButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Bg"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="20" />
                            <!--
                                State layer: the label colour at low opacity, so hover and
                                press can be animated with a single opacity ramp and stay
                                correct in every colour scheme.
                            -->
                            <Border x:Name="StateLayer"
                                    Background="{DynamicResource OnPrimaryBrush}"
                                    Opacity="0"
                                    CornerRadius="20" />
                            <!--
                                Ripple, clipped to the button's own 20dp radius so the expanding
                                circle never spills past the corners.
                            -->
                            <Border CornerRadius="20" ClipToBounds="True">
                                <Ellipse x:Name="Ripple"
                                         Fill="{StaticResource RippleBrush}"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RippleScale" ScaleX="0.2" ScaleY="0.2" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.14" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard Storyboard="{StaticResource MdRippleExpand}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!--
                                M3 disabled: 12% on-surface container with a 38% on-surface
                                label. Without this a disabled button is indistinguishable
                                from an enabled one, which hides why nothing happens.
                            -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DisabledContainerBrush}" />
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledLabelBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M3 outlined button — text button with a 1dp outline -->
        <Style x:Key="MdOutlinedButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Bg"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20" />
                            <Border x:Name="StateLayer"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Opacity="0"
                                    CornerRadius="20" />
                            <Border CornerRadius="20" ClipToBounds="True">
                                <Ellipse x:Name="Ripple"
                                         Fill="{StaticResource RippleBrush}"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RippleScale" ScaleX="0.2" ScaleY="0.2" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.14" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard Storyboard="{StaticResource MdRippleExpand}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource DisabledContainerBrush}" />
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledLabelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             M3 switch — 52x32dp track, 24dp handle (16dp when off)
            ============================================================
        -->
        <Style x:Key="MdSwitch" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="52" Height="32" Background="Transparent">
                            <!-- Track: 52x32dp, 2dp outline when off, primary fill when on -->
                            <Border x:Name="Track"
                                    Width="52" Height="32"
                                    CornerRadius="16"
                                    Background="{DynamicResource SurfaceContainerHighestBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="2" />

                            <!--
                                Handle: 16dp when off, 24dp when on, per the M3 switch
                                spec. The ellipse stays a fixed 24dp and is scaled and
                                translated instead: animating Width/Margin would run a
                                layout pass on every frame of the slide, which is what
                                made the switch visibly step rather than glide.

                                With a 4dp leading inset the unscaled centre sits at
                                16dp; the on state scales to 1.0 and shifts +20dp, which
                                puts the centre at 36dp, exactly the M3 end position.
                            -->
                            <Ellipse x:Name="Thumb"
                                     Width="24" Height="24"
                                     Fill="{DynamicResource OutlineBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ThumbScale" ScaleX="0.667" ScaleY="0.667" />
                                        <TranslateTransform x:Name="ThumbShift" X="0" />
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnPrimaryBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.667" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.667" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M3 text field: filled variant, 56dp tall, 4dp top corners -->
        <Style x:Key="MdTextField" TargetType="TextBox">
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{DynamicResource InputFillBrush}"
                                    CornerRadius="4,4,0,0" />
                            <Border x:Name="Hover"
                                    Background="Transparent"
                                    CornerRadius="4,4,0,0" />
                            <!-- 1dp resting underline; 2dp primary when focused -->
                            <Border x:Name="Underline"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource OutlineBrush}" />
                            <Border x:Name="FocusLine"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource InputHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             M3 segmented button — one segment of a 40dp outlined container.
             Unselected: transparent with an on-surface label.
             Selected:   secondary-container fill, on-secondary-container label.
            ============================================================
        -->
        <Style x:Key="MdSegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid ClipToBounds="True">
                            <Border x:Name="Fill" Background="Transparent" CornerRadius="19" />
                            <Border x:Name="StateLayer" CornerRadius="19" Opacity="0" Background="{DynamicResource OnSurfaceBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStatePressIn}" />
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             Injector status pill — a compact state badge on the target card.
             The fill is set per state from code, so no trigger is needed here.
            ============================================================
        -->
        <Style x:Key="MdStatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            ============================================================
             Selectable target card — an M3 card that behaves like a radio option.
             Unselected: surface-container with an outline-variant border.
             Selected:   primary-tinted border so the active target is obvious.
            ============================================================
        -->
        <Style x:Key="MdTargetCard" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CardPress" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Card"
                                    Width="248"
                                    Padding="18"
                                    CornerRadius="12"
                                    Background="{DynamicResource SurfaceContainerBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <!--
                                Selection ring, drawn as a separate 2dp overlay rather
                                than by thickening the card border. Changing
                                BorderThickness re-measures the content and nudges the
                                card's text by a pixel on every selection.
                            -->
                            <Border x:Name="SelectionRing"
                                    Width="248"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardPress"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.985" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="CardPress"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.985" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardPress"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardPress"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             Colour-scheme swatch — a compact selectable card in the picker.
             The selected swatch gets a 2dp primary ring, which is the M3
             selected-container treatment.
            ============================================================
        -->
        <Style x:Key="MdSchemeSwatch" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame"
                                Width="92"
                                Padding="8"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             M3 filter chip — 32dp tall, 8dp corner, 1dp outline. The
             selected chip fills with the secondary-container role.
            ============================================================
        -->
        <Style x:Key="MdChipButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid ClipToBounds="True">
                            <Border x:Name="Bg"
                                    Height="32"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    Background="Transparent" />
                            <Border x:Name="StateLayer"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="Transparent" />
                            <ContentPresenter Margin="14,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource MdStateHoverOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             M3 extended FAB — 56dp tall, 16dp corner, primary container.
             Used for the single primary action, floated bottom-right.
            ============================================================
        -->
        <Style x:Key="MdFab" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MdTextFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <!--
                                Elevation stand-in. A plain blurred border would re-run a
                                Gaussian blur every frame while the FAB scales on press,
                                so the shadow is a cached gradient: identical look, no
                                per-frame effect pass.
                            -->
                            <Border CornerRadius="16" Margin="0,5,0,0" Opacity="0.30">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.62" />
                                        <GradientStop Color="#40000000" Offset="0.86" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Bg"
                                    Background="{DynamicResource PrimaryContainerBrush}"
                                    CornerRadius="16" />
                            <Border x:Name="StateLayer"
                                    Background="{DynamicResource OnPrimaryContainerBrush}"
                                    Opacity="0"
                                    CornerRadius="16" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.14" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Springy release, so the tap feels physical. -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Press"
                                                                           Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Press"
                                                                           Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DisabledContainerBrush}" />
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledLabelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============================================================
             M3 scrollbar — an 8dp rounded thumb with no arrow buttons.
             The thumb greys out at rest and strengthens on hover/drag,
             which is the Material treatment.
            ============================================================
        -->
        <Style x:Key="MdScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar"
                                Width="8"
                                Margin="2,0"
                                CornerRadius="4"
                                Background="{DynamicResource ScrollThumbBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MdScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

