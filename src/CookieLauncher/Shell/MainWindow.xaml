<Window x:Class="CookieLauncher.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:CookieLauncher.UI"
        Title="Cookie Launcher"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="680"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource MdTextFont}"
        SourceInitialized="OnSourceInitialized"
        StateChanged="OnWindowStateChanged">

    <!--
        WindowStyle=None removes the OS frame; WindowChrome keeps the snap behaviour
        without drawing a caption. CaptionHeight=0 means every pixel of the title bar is
        ours to handle, which is what lets the M3 app bar double as the title bar.

        GlassFrameThickness=-1 extends the DWM composition frame over the whole window.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--
        RootBorder paints the frosted tint over the DWM backdrop, and the hairline stroke
        is a theme token so the light scheme turns this into white frosted glass.
    -->
    <Border x:Name="RootBorder"
            BorderThickness="1"
            CornerRadius="0"
            Background="{DynamicResource GlassTintBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Layer 1: ambient haze. Spans both rows and columns so the colour drifts
                under the app bar and the rail as well as the page area. It is the first
                child so nothing has to be reordered later.
            -->
            <ui:AmbientBackground x:Name="Ambient"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2" />

            <!-- ==================== M3 top app bar ==================== -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Height="60"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <ui:AppMark Width="24" Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="Cookie Launcher"
                               Margin="10,0,0,0"
                               FontFamily="{StaticResource MdTextFont}"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Margin="12,0"
                            Background="{DynamicResource OutlineVariantBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="DestinationTitle"
                               FontFamily="{StaticResource MdTextFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <ContentControl x:Name="AppBarActions" VerticalAlignment="Center" />
                    <Button x:Name="MinimiseButton"
                            Style="{StaticResource MdWindowButton}"
                            Content="&#xE921;"
                            Click="OnMinimise" />
                    <Button x:Name="MaximiseButton"
                            Style="{StaticResource MdWindowButton}"
                            Content="&#xE922;"
                            Click="OnMaximise" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource MdCloseWindowButton}"
                            Content="&#xE8BB;"
                            Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- ==================== M3 navigation rail ==================== -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Width="228"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,1,0">
                <StackPanel Margin="12,14,12,14">
                    <RadioButton x:Name="NavPlay"
                                 Style="{StaticResource MdNavRailItem}"
                                 Tag="home"
                                 IsChecked="True"
                                 Checked="OnNavChecked">
                        <StackPanel>
                            <Path Data="{StaticResource PlayGlyph}" Width="22" Height="22"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Play" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavVersions"
                                 Style="{StaticResource MdNavRailItem}"
                                 Tag="versions"
                                 Checked="OnNavChecked">
                        <StackPanel>
                            <Path Data="{StaticResource VersionsGlyph}" Width="22" Height="22"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Versions" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMods"
                                 Style="{StaticResource MdNavRailItem}"
                                 Tag="mods"
                                 Checked="OnNavChecked">
                        <StackPanel>
                            <Path Data="{StaticResource ModsGlyph}" Width="22" Height="22"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Mods" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAccounts"
                                 Style="{StaticResource MdNavRailItem}"
                                 Tag="accounts"
                                 Checked="OnNavChecked">
                        <StackPanel>
                            <Path Data="{StaticResource AccountGlyph}" Width="22" Height="22"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Accounts" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLogs"
                                 Style="{StaticResource MdNavRailItem}"
                                 Tag="log"
                                 Checked="OnNavChecked">
                        <StackPanel>
                            <Path Data="{StaticResource LogsGlyph}" Width="22" Height="22"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Logs" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource MdNavRailItem}"
                                 Tag="settings"
                                 Checked="OnNavChecked">
                        <StackPanel>
                            <Path Data="{StaticResource SettingsGlyph}" Width="22" Height="22"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Settings" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ==================== Page host ==================== -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHost" Grid.Row="0" />

                <Border Grid.Row="1"
                        Height="30"
                        Background="{DynamicResource SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="18,0">
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource MdLabelSmall}"
                                   Text="Ready"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusRight"
                                   Style="{StaticResource MdLabelSmall}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== Snackbar host ==================== -->
            <ContentControl x:Name="SnackbarHost"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"
                            IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
