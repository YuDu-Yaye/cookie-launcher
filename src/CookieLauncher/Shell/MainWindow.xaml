<Window x:Class="CookieLauncher.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:CookieLauncher.UI"
        Title="Cookie Launcher"
        Width="1180"
        Height="700"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource MdTextFont}"
        SourceInitialized="OnSourceInitialized"
        StateChanged="OnWindowStateChanged">

    <!--
        The arrangement follows PCL2 rather than inventing a new one: a compact top
        strip with a pill-shaped destination group, a left column holding the account
        card and the large launch block, and a wide content area on the right. Only the
        components are Material 3; the layout is the one PCL2 users already know.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            BorderThickness="1"
            ClipToBounds="True"
            Background="{DynamicResource GlassTintBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- PCL2's top bar is a compact strip, not a 64dp app bar. -->
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:AmbientBackground x:Name="Ambient" Grid.RowSpan="2" />

            <!-- ==================== Top bar ==================== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                    <ui:AppMark Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="Cookie Launcher"
                               Margin="10,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Pill destination group, centred like PCL2's capsule bar. -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Height="40"
                        CornerRadius="20"
                        Background="{DynamicResource SurfaceContainerHighBrush}"
                        Padding="4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="NavPlay" Style="{StaticResource MdPillTab}"
                                     Tag="home" Content="Play" IsChecked="True"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavInstances" Style="{StaticResource MdPillTab}"
                                     Tag="instances" Content="Instances"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavVersions" Style="{StaticResource MdPillTab}"
                                     Tag="versions" Content="Download"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource MdPillTab}"
                                     Tag="settings" Content="Settings"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavMore" Style="{StaticResource MdPillTab}"
                                     Tag="more" Content="More"
                                     Checked="OnNavChecked" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource MdWindowButton}" Content="&#xE921;"
                            ToolTip="Minimise" Click="OnMinimise" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource MdWindowButton}"
                            Content="&#xE922;" ToolTip="Maximise" Click="OnMaximise" />
                    <Button Style="{StaticResource MdCloseWindowButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- ==================== Body ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column: account and launch -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid Margin="18,16,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Login type switch -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <RadioButton x:Name="LoginOnline" Style="{StaticResource MdSegmentedTab}"
                                         Content="Online" GroupName="login"
                                         IsChecked="True" Checked="OnLoginTypeChanged" />
                            <RadioButton x:Name="LoginOffline" Style="{StaticResource MdSegmentedTab}"
                                         Content="Offline" GroupName="login"
                                         Margin="6,0,0,0" Checked="OnLoginTypeChanged" />
                        </StackPanel>

                        <!-- Avatar, name, account actions -->
                        <StackPanel Grid.Row="1" Margin="0,28,0,0" HorizontalAlignment="Center">
                            <Border x:Name="AvatarHost"
                                    Width="96" Height="96"
                                    CornerRadius="12"
                                    Background="{DynamicResource SurfaceContainerHighestBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="AvatarInitials"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            </Border>
                            <TextBlock x:Name="AccountName"
                                       Text="No account"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock x:Name="AccountKind"
                                       Text="Add one to play online"
                                       FontSize="11.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <Button x:Name="SwitchAccountButton"
                                    Content="Switch account"
                                    Style="{StaticResource MdTextButton}"
                                    Height="32"
                                    Margin="0,10,0,0"
                                    Click="OnSwitchAccount" />
                        </StackPanel>

                        <ContentControl Grid.Row="2" />

                        <!-- Launch block pinned to the bottom, as PCL2 does -->
                        <StackPanel Grid.Row="3">
                            <Border x:Name="LaunchSurface"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    Padding="14,12"
                                    Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource PlayGlyph}"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource PrimaryBrush}" />
                                        <TextBlock x:Name="LaunchLabel"
                                                   Text="Launch game"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="LaunchVersion"
                                               Text="No version selected"
                                               FontSize="11.5"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Select"
                                        Style="{StaticResource MdOutlinedButton}"
                                        Height="38" Padding="12,0" Click="OnVersionSelect" />
                                <Button Grid.Column="1" Content="Settings"
                                        Style="{StaticResource MdOutlinedButton}"
                                        Height="38" Padding="12,0" Margin="8,0,0,0"
                                        Click="OnVersionSettings" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right column: page host -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="PageHost" Grid.Row="0" />

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="20,0">
                            <TextBlock x:Name="StatusText" Style="{StaticResource MdLabelSmall}"
                                       Text="Ready" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusRight" Style="{StaticResource MdLabelSmall}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ContentControl x:Name="SnackbarHost"
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,36"
                            IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
