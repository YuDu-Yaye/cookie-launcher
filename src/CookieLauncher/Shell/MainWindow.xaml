<Window x:Class="CookieLauncher.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:CookieLauncher.UI"
        Title="Cookie Launcher"
        Width="1040"
        Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource MdTextFont}"
        SourceInitialized="OnSourceInitialized"
        StateChanged="OnWindowStateChanged">

    <!--
        WindowStyle=None removes the OS frame; WindowChrome keeps snap and
        double-click maximise without drawing a caption. CaptionHeight=0 makes the
        M3 app bar the title bar.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            BorderThickness="1"
            ClipToBounds="True"
            Background="{DynamicResource GlassTintBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- M3 top app bar: 64dp -->
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- M3 navigation rail: 232dp with label, comfortably above the 80dp minimum -->
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Layer 1: ambient haze. Spans the whole grid so the colour drifts under
                the app bar and the rail as well as the page area.
            -->
            <ui:AmbientBackground x:Name="Ambient"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2" />

            <!-- ==================== M3 top app bar ==================== -->
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <ui:AppMark Width="24" Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="Cookie Launcher"
                               Margin="12,0,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Margin="16,0"
                            Background="{DynamicResource OutlineVariantBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="DestinationTitle"
                               FontSize="14"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource MdWindowButton}"
                            Content="&#xE921;" ToolTip="Minimise"
                            Click="OnMinimise" />
                    <Button x:Name="MaximiseButton"
                            Style="{StaticResource MdWindowButton}"
                            Content="&#xE922;" ToolTip="Maximise"
                            Click="OnMaximise" />
                    <Button Style="{StaticResource MdCloseWindowButton}"
                            Content="&#xE8BB;" ToolTip="Close"
                            Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- ==================== M3 navigation rail ==================== -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,14,4,0">
                        <RadioButton x:Name="NavPlay"
                                     Style="{StaticResource MdNavRailItem}"
                                     Tag="home"
                                     IsChecked="True"
                                     ToolTip="Play"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <Path Data="{StaticResource PlayGlyph}" Width="22" Height="22"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Play" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavVersions"
                                     Style="{StaticResource MdNavRailItem}"
                                     Tag="versions"
                                     ToolTip="Versions"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <Path Data="{StaticResource VersionsGlyph}" Width="22" Height="22"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Versions" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavMods"
                                     Style="{StaticResource MdNavRailItem}"
                                     Tag="mods"
                                     ToolTip="Mods"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <Path Data="{StaticResource ModsGlyph}" Width="22" Height="22"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Mods" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAccounts"
                                     Style="{StaticResource MdNavRailItem}"
                                     Tag="accounts"
                                     ToolTip="Accounts"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <Path Data="{StaticResource AccountGlyph}" Width="22" Height="22"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Accounts" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavLogs"
                                     Style="{StaticResource MdNavRailItem}"
                                     Tag="log"
                                     ToolTip="Logs"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <Path Data="{StaticResource LogsGlyph}" Width="22" Height="22"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Logs" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings"
                                     Style="{StaticResource MdNavRailItem}"
                                     Tag="settings"
                                     ToolTip="Settings"
                                     Checked="OnNavChecked">
                            <StackPanel>
                                <Path Data="{StaticResource SettingsGlyph}" Width="22" Height="22"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Settings" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Version pinned to the bottom of the rail. -->
                    <TextBlock x:Name="VersionLabel"
                               Grid.Row="1"
                               Margin="0,0,0,14"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Opacity="0.7" />
                </Grid>
            </Border>

            <!-- ==================== Page host ==================== -->
            <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHost" Grid.Row="0" />

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource MdLabelSmall}"
                                   Text="Ready"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusRight"
                                   Style="{StaticResource MdLabelSmall}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== Snackbar ==================== -->
            <ContentControl x:Name="SnackbarHost"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,48"
                            IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
